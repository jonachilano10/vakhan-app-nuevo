# Google OAuth / NextAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Local: http://localhost:3000. Produccion: URL HTTPS publica, sin barra final.
NEXTAUTH_URL=http://localhost:3000
# Correos de entrenadores separados por coma. Requerido; no usar datos de produccion.
TRAINER_EMAILS=trainer@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Sólo servidor. Nunca usar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=
